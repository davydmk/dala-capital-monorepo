# Боевые переменные. Скопировать в `.env` рядом и заполнить.
# Файл с настоящими значениями в репозиторий не попадает — см. .gitignore.

# Домены. Приложение живёт на поддомене, корень оставлен под лендинг.
APP_DOMAIN=app.dala-capital.live
ROOT_DOMAIN=dala-capital.live
CORS_ORIGIN=https://app.dala-capital.live

# Подпись сессий. Сгенерировать: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# База. Пароль сгенерировать так же; наружу порт не открыт.
POSTGRES_USER=dala
POSTGRES_PASSWORD=
POSTGRES_DB=dala

# Сеть Solana. Публичный узел devnet отвечает 429 под нагрузкой — на стенде
# лучше указать свой: бэкенд переживает отказ, но операция не пройдёт.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
SOLANA_PROGRAM_ID=JCLPbcLwdYJs1UJgL6LK1nhYRUcGk5ziFPx55nVL9akB
# Расчётный токен стенда: тестовый USDC, которым идут все расчёты.
SOLANA_USDC_MINT=Gh9ZwEmdLJ8DscKNTkTqPbNwLNNBjuSzaG9Vp2KGtKJr

# Пути внутри контейнера; сами файлы лежат в /srv/dala/secrets на машине.
SOLANA_ADMIN_KEYPAIR=/run/secrets/admin.json
SOLANA_OPERATOR_KEYPAIR=/run/secrets/operator.json
SOLANA_WHITELIST_KEYPAIR=/run/secrets/whitelist.json
