# Caddy сам получает сертификат Let's Encrypt и сам его продлевает.
# Домены приходят из .env: тот же файл читают и остальные службы.

{$APP_DOMAIN} {
	encode zstd gzip

	# Документы инвесторов и заёмщиков — до 10 МБ; с запасом на границы форм.
	request_body {
		max_size 12MB
	}

	reverse_proxy frontend:3000

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# Корень домена оставлен под лендинг. Пока его нет, человек, набравший голое
# имя, попадает в приложение, а не в ошибку.
{$ROOT_DOMAIN}, www.{$ROOT_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} temporary
}
